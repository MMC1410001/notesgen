# Copy to .env and fill in whichever provider you want to use.
# .env is gitignored. Environment variables always win over this file.

# Which backend generates the notes.
# claude-cli (default when the `claude` CLI is installed) | anthropic | openai | gemini
# NOTESGEN_PROVIDER=claude-cli

# Only needed for the API providers. claude-cli uses your Claude Code
# subscription and needs no key.
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=...
